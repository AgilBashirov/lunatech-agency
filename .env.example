# Telegram bot used by /api/contact to deliver form submissions.
# Get a token from @BotFather and add your channel/group id below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GA4 Measurement ID (Google Analytics 4 property → Admin → Data Streams →
# your web stream). Format: G-XXXXXXXXXX. Leave empty to skip GA4 entirely —
# the Google Ads tag in src/app/layout.tsx keeps working either way.
NEXT_PUBLIC_GA4_ID=
